# Bu faylni .env deb nusxalang va qiymatlarni to'ldiring. .env GitHub'ga yuklanmaydi.

# --- Majburiy ---
OPENAI_API_KEY=sk-...

# --- Ixtiyoriy (standart qiymatlar yaxshi ishlaydi) ---
CHANNEL_NAME=SprunkiCoreee
CHANNEL_HANDLE=@SprunkiCoreee
OPENAI_MODEL=gpt-4o-mini

# Ovoz. Yaxshi variantlar: en-US-AndrewMultilingualNeural, en-US-ChristopherNeural, en-US-AnaNeural (bola ovozi)
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+8%

# pollinations = bepul AI rasm, none = faqat sizning rasmlaringiz va animatsion fon
IMAGE_PROVIDER=pollinations

# YouTube
YT_PRIVACY=private
MADE_FOR_KIDS=true
# 20 = Gaming, 24 = Entertainment
YT_CATEGORY_ID=20

# Kanal maskoti-boshlovchisi (original personaj)
HOST_MASCOT=true
HOST_NAME=Coree

# Fon musiqasi: auto (assets/music bo'lsa o'shani, bo'lmasa original beat), generated (har doim original beat), assets, off
MUSIC_MODE=auto
MUSIC_VOLUME=0.12
