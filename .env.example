# Bu faylni .env deb nusxalang va qiymatlarni to'ldiring. .env GitHub'ga yuklanmaydi.

# --- Majburiy ---
OPENAI_API_KEY=sk-...

# --- Ixtiyoriy (standart qiymatlar yaxshi ishlaydi) ---
CHANNEL_NAME=Sprunki Core
OPENAI_MODEL=gpt-4o-mini

# Ovozlar ro'yxati: edge-tts --list-voices
# Yaxshi variantlar: en-US-AndrewMultilingualNeural, en-US-ChristopherNeural, en-US-AnaNeural (bola ovozi)
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+8%

# pollinations = bepul AI rasm, none = faqat sizning rasmlaringiz va rangli fon
IMAGE_PROVIDER=pollinations

# YouTube
YT_PRIVACY=private
MADE_FOR_KIDS=true
# 20 = Gaming, 24 = Entertainment
YT_CATEGORY_ID=20

MUSIC_VOLUME=0.10
